{
  "permissions": {
    "allow": [
      "Bash(npm test *)",
      "Bash(npx tsc *)",
      "Bash(git add *)",
      "Bash(git mv *)",
      "Bash(git rm *)",
      "Bash(lsof -i :5050 -sTCP:LISTEN)",
      "WebFetch(domain:docs.brightdata.com)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/log-edit.sh"
          }
        ]
      }
    ]
  }
}
