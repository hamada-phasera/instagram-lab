# Bright Data — Instagram dataset IDs (set in Bright Data console)
BRIGHT_DATA_API_KEY=
# Hashtag discovery (primary genre-crossing flow): the Instagram *posts*
# dataset, triggered by /collect type=hashtag with
# `type=discover_new&discover_by=hashtag`. Copy the "Instagram - Posts"
# dataset id from your Bright Data console (commonly gd_lk5ns7kz21pck8jpis —
# verify against your account before the first paid run).
BRIGHT_DATA_DATASET_HASHTAG=
# Account discovery: instagram-posts-discover-by-url (gd_l1vikfch901nx3by4)
# Used by /collect when type=discover (~12 recent posts per profile).
BRIGHT_DATA_DATASET_DISCOVER=
# Optional / legacy direct collect-by-URL scrapers (UI does not surface these).
BRIGHT_DATA_DATASET_POSTS=
BRIGHT_DATA_DATASET_REELS=
BRIGHT_DATA_DATASET_COMMENTS=

# Anthropic — Claude API key (server-side only)
ANTHROPIC_API_KEY=

# Vercel Blob — storage for collected JSON files
# Local dev: leave empty → falls back to `data/*.json` on local disk
# Production: required (Vercel serverless filesystem is ephemeral / read-only)
# Get one via: `vercel blob create` or the Vercel dashboard → Storage → Blob
BLOB_READ_WRITE_TOKEN=
